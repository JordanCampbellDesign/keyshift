{
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "rewrites": [
    {
      "source": "/download",
      "destination": "/api/download"
    }
  ],
  "redirects": [
    {
      "source": "/zip",
      "destination": "/download",
      "permanent": false
    },
    {
      "source": "/install",
      "destination": "/#install",
      "permanent": false
    },
    {
      "source": "/help",
      "destination": "/#help",
      "permanent": false
    },
    {
      "source": "/github",
      "destination": "https://github.com/JordanCampbellDesign/keyshift",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/chat.js": {
      "includeFiles": "index.html",
      "maxDuration": 30
    }
  }
}
