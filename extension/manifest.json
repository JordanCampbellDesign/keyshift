{
   "manifest_version": 3,
   "name": "Keyshift",
   "description": "Change the pitch and tempo of any tab's audio, and split songs into stems on your device.",
   "version": "1.0.0",
   "minimum_chrome_version": "116",
   "background": {
      "service_worker": "background.js"
   },
   "action": {
      "default_icon": {
         "16": "images/icon16.png",
         "32": "images/icon32.png",
         "48": "images/icon48.png",
         "128": "images/icon128.png"
      },
      "default_popup": "popup.html"
   },
   "icons": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
   },
   "permissions": [
      "activeTab",
      "tabs",
      "tabCapture",
      "scripting",
      "offscreen",
      "storage"
   ],
   "commands": {
      "pitch-up": {
         "suggested_key": {
            "default": "Alt+Up"
         },
         "description": "Pitch up 1 semitone"
      },
      "pitch-down": {
         "suggested_key": {
            "default": "Alt+Down"
         },
         "description": "Pitch down 1 semitone"
      },
      "speed-up": {
         "suggested_key": {
            "default": "Alt+Period"
         },
         "description": "Speed up 5%"
      },
      "speed-down": {
         "suggested_key": {
            "default": "Alt+Comma"
         },
         "description": "Speed down 5%"
      }
   },
   "optional_host_permissions": [
      "<all_urls>"
   ],
   "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
   },
   "homepage_url": "https://github.com/JordanCampbellDesign/keyshift"
}
